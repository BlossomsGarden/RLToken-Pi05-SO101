{
  // Evaluation config — replace every path with your own local checkpoints.
  "pi05_path": "/path/to/your/sft/lerobot_pretrained",
  "rlt_checkpoint": "/path/to/your/rlt_stage1/best_checkpoint.pt",
  "actor_checkpoint": "/path/to/your/rlt_stage2/final_checkpoint.pt",
  "tokenizer_path": "/path/to/your/tokenizer",
  "stats_path": "/path/to/your/dataset/meta/stats.json",
  "task": "Pick up the red block and place it on top of the green block.",
  "follower_port": "COM5",
  "follower_id": "so101_follower",
  "cameras": {
    "front": {"type": "opencv", "index_or_path": 0, "width": 640, "height": 480, "fps": 30},
    "side": {"type": "opencv", "index_or_path": 1, "width": 640, "height": 480, "fps": 30}
  },
  "camera_map": {
    "front": "observation.images.front",
    "side": "observation.images.side"
  },
  "episodes": 10,
  "steps_per_episode": 1000,
  "control_fps": 30.0,
  "rtc_execution_horizon": 10,
  "actor_execution_steps": 10,
  "display_data": true,
  "score_episodes": true,
  "device": "cuda",
  "dry_run": true
}
